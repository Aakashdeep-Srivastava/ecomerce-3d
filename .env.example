# Which white-label client config to build (see src/config/clients/).
# Defaults to "aavriti" if unset.
VITE_CLIENT=aavriti

# --- Shopify Storefront API (optional) ---------------------------------
# When both DOMAIN and STOREFRONT_TOKEN are set, the app uses live products,
# cart, and hosted checkout. Otherwise it runs in demo-cart mode.
# The Storefront token is a PUBLIC token and is safe to expose client-side.
# Never put the Shopify Admin API token here.
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Optional:
VITE_SHOPIFY_API_VERSION=2024-10
VITE_SHOPIFY_COLLECTION_HANDLE=
